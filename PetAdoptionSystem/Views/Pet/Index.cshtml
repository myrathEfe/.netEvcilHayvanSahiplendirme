@model PetFilterViewModel
@{
    ViewData["Title"] = "İlanlar";
    var userRole = Context.Session.GetString(SessionKeys.UserRole);
    var isAdmin = userRole == RoleNames.Admin;
}

<div class="page-heading d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
    <div>
        <div class="page-kicker mb-2">Sahiplendirme</div>
        <h1 class="h2 mb-2">Yeni dostunuzu keşfedin</h1>
        <p class="text-muted mb-0">Evcil hayvan ilanlarını filtreleyin, detayları inceleyin ve uygun dostlara kolayca ulaşın.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">Yeni İlan Ekle</a>
    }
</div>

<div class="card filter-card mb-4">
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-4">
                <label asp-for="Name" class="form-label">İsim</label>
                <input asp-for="Name" class="form-control" placeholder="Örn: Boncuk" />
            </div>

            <div class="col-md-4">
                <label asp-for="Species" class="form-label">Tür</label>
                <select asp-for="Species" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var species in Enum.GetValues<SpeciesType>())
                    {
                        <option value="@species">@species.GetDisplayName()</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="Breed" class="form-label">Cins</label>
                <input asp-for="Breed" class="form-control" placeholder="Örn: Golden" />
            </div>

            <div class="col-md-4">
                <label asp-for="City" class="form-label">Şehir</label>
                <input asp-for="City" class="form-control" placeholder="Örn: İstanbul" />
            </div>

            <div class="col-md-2">
                <label asp-for="MinAge" class="form-label">Min Yaş</label>
                <input asp-for="MinAge" class="form-control" min="0" />
            </div>

            <div class="col-md-2">
                <label asp-for="MaxAge" class="form-label">Max Yaş</label>
                <input asp-for="MaxAge" class="form-control" min="0" />
            </div>

            <div class="col-md-4">
                <label asp-for="AdoptionStatus" class="form-label">Sahiplendirme Durumu</label>
                <select asp-for="AdoptionStatus" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var status in Enum.GetValues<AdoptionStatus>())
                    {
                        <option value="@status">@status.GetDisplayName()</option>
                    }
                </select>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Filtrele</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Pets.Any())
{
    <div class="row g-4 pet-grid">
        @foreach (var pet in Model.Pets)
        {
            <div class="col-lg-4 col-md-6">
                <article class="card pet-card">
                    <div class="pet-media">
                        @if (pet.ImageData is not null)
                        {
                            <img src="@Url.Action("Image", "Pet", new { id = pet.Id })" class="pet-card-image" alt="@pet.Name" />
                        }
                        else
                        {
                            <div class="pet-card-placeholder">Fotoğraf Yok</div>
                        }
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="h5 mb-1">@pet.Name</h2>
                                <div class="text-muted small">@pet.Breed</div>
                            </div>
                            <span class="pet-status-badge @(pet.AdoptionStatus == AdoptionStatus.Available ? "is-available" : "is-adopted")">
                                @pet.AdoptionStatus.GetDisplayName()
                            </span>
                        </div>

                        <div class="pet-chip-list mb-3">
                            <span class="pet-chip">@pet.Species.GetDisplayName()</span>
                            <span class="pet-chip">@pet.City</span>
                            <span class="pet-chip">@pet.Age yaş</span>
                        </div>

                        <a class="pet-contact-link mb-3" href="tel:@pet.ContactPhone.Replace(" ", "")">
                            <span>İletişim</span>
                            <strong>@pet.ContactPhone</strong>
                        </a>

                        <p class="pet-description mb-4 flex-grow-1">@(string.IsNullOrWhiteSpace(pet.Description) ? "Açıklama eklenmemiş." : pet.Description)</p>

                        <div class="pet-actions d-flex flex-wrap gap-2 mt-auto">
                            <a asp-action="Details" asp-route-id="@pet.Id" class="btn btn-primary btn-sm">Detayları Gör</a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-outline-secondary btn-sm">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@pet.Id" class="btn btn-outline-danger btn-sm">Sil</a>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    <div class="card empty-state">
        <div class="card-body p-5 text-center">
            <h2 class="h4 mb-2">Sonuç bulunamadı</h2>
            <p class="text-muted mb-0">Filtreleri değiştirerek tekrar deneyebilirsiniz.</p>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
