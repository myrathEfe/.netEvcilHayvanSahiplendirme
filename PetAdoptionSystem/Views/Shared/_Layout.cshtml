<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ShelterInfo.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetAdoptionSystem.styles.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_Navbar")
    <div class="container app-shell">
        @if (TempData["StatusMessage"] is string message)
        {
            var statusType = TempData["StatusType"]?.ToString() ?? "info";
            <div class="alert alert-@statusType alert-dismissible fade show shadow-sm" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container py-3">
            @ShelterInfo.Name | Nilüfer Belediyesi barınak sahiplendirme servisi
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
