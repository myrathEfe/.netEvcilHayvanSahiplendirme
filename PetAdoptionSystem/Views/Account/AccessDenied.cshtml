@{
    ViewData["Title"] = "Yetkisiz Erişim";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5 text-center">
                <h1 class="h3 mb-3">Bu alana erişim yetkiniz yok.</h1>
                <p class="text-muted mb-4">Yalnızca admin kullanıcılar ilan ekleme, düzenleme ve silme işlemi yapabilir.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Pet" asp-action="Index" class="btn btn-outline-primary">İlanlara Dön</a>
                    <a asp-controller="Dashboard" asp-action="Dashboard" class="btn btn-primary">Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
