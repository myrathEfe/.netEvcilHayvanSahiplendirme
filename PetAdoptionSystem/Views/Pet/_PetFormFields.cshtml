@model PetFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Breed" class="form-label"></label>
        <input asp-for="Breed" class="form-control" />
        <span asp-validation-for="Breed" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Species" class="form-label"></label>
        <select asp-for="Species" class="form-select" data-species-select>
            <option value="">Seçiniz</option>
            @foreach (var species in Enum.GetValues<SpeciesType>())
            {
                <option value="@species">@species.GetDisplayName()</option>
            }
        </select>
        <span asp-validation-for="Species" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender" class="form-select">
            <option value="">Seçiniz</option>
            @foreach (var gender in Enum.GetValues<GenderType>())
            {
                <option value="@gender">@gender.GetDisplayName()</option>
            }
        </select>
        <span asp-validation-for="Gender" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Age" class="form-label"></label>
        <input asp-for="Age" class="form-control" min="0" />
        <span asp-validation-for="Age" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ContactPhone" class="form-label"></label>
        <input asp-for="ContactPhone" class="form-control" placeholder="Örn: 0532 123 45 67" />
        <span asp-validation-for="ContactPhone" class="text-danger small"></span>
    </div>

    <div class="col-md-6 sterilization-field" data-sterilization-field>
        <label asp-for="SterilizationStatus" class="form-label"></label>
        <select asp-for="SterilizationStatus" class="form-select" data-sterilization-select>
            <option value="">Seçiniz</option>
            @foreach (var status in Enum.GetValues<SterilizationStatus>())
            {
                <option value="@status">@status.GetDisplayName()</option>
            }
        </select>
        <span asp-validation-for="SterilizationStatus" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="DisabilityStatus" class="form-label"></label>
        <select asp-for="DisabilityStatus" class="form-select" data-disability-select>
            <option value="@DisabilityStatus.No">@DisabilityStatus.No.GetDisplayName()</option>
            <option value="@DisabilityStatus.Yes">@DisabilityStatus.Yes.GetDisplayName()</option>
            <option value="@DisabilityStatus.Unknown">@DisabilityStatus.Unknown.GetDisplayName()</option>
        </select>
        <span asp-validation-for="DisabilityStatus" class="text-danger small"></span>
    </div>

    <div class="col-12 disability-description-field" data-disability-description-field>
        <label asp-for="DisabilityDescription" class="form-label"></label>
        <textarea asp-for="DisabilityDescription" class="form-control" rows="3" placeholder="Örn: Sağır, görme engelli, yürüme zorluğu var..." data-disability-description></textarea>
        <span asp-validation-for="DisabilityDescription" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="ImageFile" class="form-label"></label>
        <input asp-for="ImageFile" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
        <span asp-validation-for="ImageFile" class="text-danger small"></span>
    </div>
</div>
